[gd_resource type="Resource" script_class="DialogueData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/hub/dialogue_data.gd" id="1_dialogue"]

[resource]
script = ExtResource("1_dialogue")
speaker = "陆沉"
lines = Array[String](["昌子，你终于回来了。档案馆的灯还亮着，说明世界还没彻底忘记我们。", "天空像被撕开的书页，时间在上面漏下来。你看到的那些破碎区，都是被改写过的记录。", "别急着去战斗。先学会读。把手伸过来——我替你解开一个一直卡在你喉咙里的词。", "灯芯又短了一截。你每带回一个词，它就亮一点；别问我烧的是什么。", "如果有一天你发现名册上少了一页，先别急着补。有些空白是有人特意留下的。", "你问世界为什么碎。我更想问：碎之前，谁在替它装订？", "把今天听见的话记下来。不是为了我，是为了你以后还能认出自己。", "灯油不多了。你带回来的记忆越重，灯烧得越慢——这不是好事，说明有些东西正在变沉。", "名册上的字会自己挪位置。我按住的只是今天这一页；昨天那一页，已经不听我的了。", "别把碎片都交给我。留一点在身上，疼的时候你会知道该往哪儿翻。", "有些名字不能念出声。你念了，它就会以为自己还活着。"])
