[gd_resource type="Resource" script_class="DialogueData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/hub/dialogue_data.gd" id="1_dialogue"]

[resource]
script = ExtResource("1_dialogue")
speaker = "白榆"
lines = Array[String](["路还在。只是这次，你想走哪一条？", "地图上有七个点。六个会关门，一个不会。", "别急着谢我。有些路，走进去之后才算开始。", "桥断了也没关系。地图上断掉的地方，往往还有一条更旧的路。", "你走前面。我习惯最后一个人过桥。", "别看桥下的水。看对岸，哪怕对岸什么也没有。", "我带过很多人过桥。记得回头的，只有你。", "桥板会响，是在数过桥的人。你听，它数到你了。", "地图上的七个点，我只走过六个。第七个，我一直在等一个愿意先走的人。", "别把桥当成路。桥只是让人过去的东西——真正留人的，是过去之后你回头看的那一眼。", "如果这次桥没断，说明对岸有你还没还完的东西。"])
