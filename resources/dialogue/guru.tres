[gd_resource type="Resource" script_class="DialogueData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/hub/dialogue_data.gd" id="1_dialogue"]

[resource]
script = ExtResource("1_dialogue")
speaker = "咕噜"
lines = Array[String](["哟，史官大人。今天想买点什么？", "我这儿只收记忆碎片，不赊账——上次赊账的那位，现在已经不记得自己姓什么了。", "看看货吧。都是些别人想不起来、我却捡得到的东西。", "今天不买东西也行。坐下歇会儿，我这儿难得有人气。", "别嫌货旧。旧东西记得的事，比新东西多。", "你要真没地方去，就在我摊子后头坐会儿。别挡着客人就行。", "旧货有个毛病：你越是想找什么，它越是不出来。慢慢翻。", "你要找的东西，未必在货架上。有时候它先看见你，才肯出来。", "我这儿最值钱的不是货，是记得。你多来几次，我就多记得你一点。", "别把旧货当死物。它们夜里会翻身，我听见了也装没听见。", "哪天我不在了，摊子归你。别嫌它破——它认得回家的路。"])
