[gd_resource type="Resource" script_class="DialogueData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/hub/dialogue_data.gd" id="1_dialogue"]

[resource]
script = ExtResource("1_dialogue")
speaker = "闻烬"
lines = Array[String](["你还活着。真可惜，我本来想把你那一页写得更精彩一点。", "别信你看到的名册。名册也会累，也会想换一种写法。", "我卖情报，不卖安慰。想听哪一段？", "老师教过我们：写下来的才算发生过。他漏教了一句——没写下来的，也不会消失。", "你把那支笔还留着？……收好。别让我看见。", "你每次回来，页边都多一道折痕。不是我折的。", "如果哪天我不记得你了，别急着纠正我。先听我把话说完。", "情报有价，沉默也有。你付得起哪一样？", "老师失踪那天，名册上多了一行空白。我查了很久，才发现空白也是字。", "你问我为什么不写你？写了，你就被定在这一页了。我还没想好怎么收尾。", "那支笔不是用来写的。至少，不是用来写别人。"])
