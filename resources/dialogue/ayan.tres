[gd_resource type="Resource" script_class="DialogueData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/hub/dialogue_data.gd" id="1_dialogue"]

[resource]
script = ExtResource("1_dialogue")
speaker = "阿砚"
lines = Array[String](["刀口又卷了？拿过来，我看看。", "断页剑的基底还能再稳一点。记忆碎片会烧掉一部分，但留下的东西不会随死亡消失。", "站稳，别动。接下来会有点疼——那是记忆在重新排列。", "别盯着炉子看。火会认人，你盯久了，它就记住你了。", "断页剑修不好，不是手艺的问题。它缺的那一页，在你身上。", "炉子今天没生火。铁砧还是热的——别问为什么。", "你身上有股墨味。刚从书里出来？把伤口给我看看。", "把碎片放在铁砧边上，别放炉里。炉子只认火，不认你舍不舍得。", "断页剑缺的那一页要是找回来，剑会先认出你，然后才认我。到时候别让它等太久。", "我打过很多把刀，只有这一把会自己挑主人。它挑得慢，是因为它也在忘。", "炉灰别扫。里面埋着上一位客人留下的名字，扫了就真没了。"])
